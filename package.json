{
  "name": "bankai-hiring",
  "version": "1.0.0",
  "description": "Courier hiring management dashboard — Express + SQLite backend and Tailwind frontend",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:css": "node build.js",
    "fetch:fonts": "node fetch-fonts.js",
    "test": "node --test tests/api.test.js",
    "test:e2e": "node tests/e2e.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "better-sqlite3": "^12.4.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "multer": "^2.5.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "tailwindcss": "^3.4.17"
  }
}
